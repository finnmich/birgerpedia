{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // No `baseUrl`: it's deprecated in TS 6 and removed in TS 7. Since TS 5.0
    // `paths` resolves relative to this file's directory on its own.
    "paths": {
      "~/*": ["./src/*"],
      "~data/*": ["./public/data/*"]
    },
    "types": ["astro/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "scripts/**/*"]
}
