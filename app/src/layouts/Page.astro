---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/vue/SearchPalette.vue';
import { u } from '../lib/url';
import { SUMMARY } from '../lib/data';
import { abs, canonicalFor, ldJson, DEFAULT_OG_IMAGE, SITE_NAME } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article' | 'profile';
  // schema.org nodes for this page, emitted as one JSON-LD @graph.
  jsonLd?: object[];
  // Keep the page out of search results (and give it no canonical).
  noindex?: boolean;
}

const {
  title = 'Birgerpedia — en hyllest til Birger Vestmo',
  description = `Alle Birger Vestmos anmeldelser for NRK Filmpolitiet fra ${SUMMARY.yearMin} til i dag, samlet og søkbare.`,
  current = '',
  ogImage = null,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = canonicalFor(Astro.url.pathname);
const image = abs(ogImage ?? DEFAULT_OG_IMAGE);
---

<!doctype html>
<html lang="nb-NO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E0B0A" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex" />
      : <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.length > 0 && <script type="application/ld+json" set:html={ldJson(jsonLd)} />}

    <link rel="preconnect" href="https://gfx.nrk.no" crossorigin />

    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Birgerpedia" href={u('/feed.xml')} />

    <script is:inline defer src="https://analytics.purpeon.com/script.js" data-website-id="5855ef13-def6-4afc-9a9c-87fd63c87d83" data-performance="true"></script>
  </head>
  <body class="vmx-body">
    <a href="#main" class="skip">Hopp til innhold</a>
    <Header current={current} />

    <main id="main" class="container-edge">
      <slot />
    </main>

    <Footer />

    <!-- Global search palette — listens for ⌘K and "/" anywhere on the page.
         `client:idle` so it doesn't block initial paint; data is fetched
         lazily the first time the user actually opens the palette. -->
    <SearchPalette client:idle />


    <script>
      // Add `loaded` class once the document is ready, to allow CSS to
      // gate first-paint reveal animations and prevent FOUC of the
      // staggered hero motions.
      document.documentElement.classList.add('vmx-ready');

      // Stagger any element with .reveal into .is-in on viewport entry.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '-5% 0px -5% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
.skip {
  position: absolute;
  left: -200%;
  background: var(--color-stamp);
  color: var(--color-paper);
  padding: 0.6rem 1rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  z-index: 100;
}
.skip:focus { left: 1rem; top: 1rem; }
</style>
