---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/vue/SearchPalette.vue';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  ogImage?: string | null;
}

const {
  title = 'Birgerpedia — en hyllest til Birger Vestmo',
  description = 'Hver eneste anmeldelse av Birger Vestmo, indeksert. NRK Filmpolitiet 2007–i dag, i ett oppslagsverk.',
  current = '',
  ogImage = null,
} = Astro.props;
---

<!doctype html>
<html lang="nb-NO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E0B0A" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://gfx.nrk.no" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Birgerpedia" href="/feed.xml" />
  </head>
  <body class="vmx-body">
    <a href="#main" class="skip">Hopp til innhold</a>
    <Header current={current} />

    <main id="main" class="container-edge">
      <slot />
    </main>

    <Footer />

    <!-- Global search palette — listens for ⌘K and "/" anywhere on the page.
         `client:idle` so it doesn't block initial paint; data is fetched
         lazily the first time the user actually opens the palette. -->
    <SearchPalette client:idle />


    <script>
      // Add `loaded` class once the document is ready, to allow CSS to
      // gate first-paint reveal animations and prevent FOUC of the
      // staggered hero motions.
      document.documentElement.classList.add('vmx-ready');

      // Stagger any element with .reveal into .is-in on viewport entry.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '-5% 0px -5% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
.skip {
  position: absolute;
  left: -200%;
  background: var(--color-stamp);
  color: var(--color-paper);
  padding: 0.6rem 1rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  z-index: 100;
}
.skip:focus { left: 1rem; top: 1rem; }
</style>
