---
const { current = '' } = Astro.props as { current?: string };
const links = [
  { href: '/',         label: 'Forsiden',   match: '/' },
  { href: '/reviews',  label: 'Indeksen',   match: 'reviews' },
  { href: '/people',   label: 'Personene',  match: 'people' },
  { href: '/stats',    label: 'Statistikk', match: 'stats' },
  { href: '/timeline', label: 'Tidslinjen', match: 'timeline' },
  { href: '/random',   label: 'Tilfeldig',  match: 'random' },
];
---

<header class="site-header">
  <div class="container-edge inner">
    <a href="/" class="brand" aria-label="Birgerpedia — forsiden">
      <span class="brand-ink">Birger<span class="brand-mid" aria-hidden="true">·</span>pedia</span>
      <span class="brand-meta">
        <span class="dot" aria-hidden="true"></span>
        <span class="meta-text">en hyllest til Birger Vestmo</span>
      </span>
    </a>

    <nav aria-label="hovednavigasjon">
      <ul class="nav">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={current === l.match ? 'page' : undefined}
              class:list={['nav-link', current === l.match && 'is-active']}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <button
            type="button"
            class="search-trigger"
            data-vmx-search-open
            aria-label="Søk (⌘K)"
            title="Søk · ⌘K"
          >
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
              <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2"/>
              <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="search-label">Søk</span>
            <span class="kbd-hint" aria-hidden="true">⌘K</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
  <div class="rule-h"></div>
</header>

<script>
  // Wire the header search-trigger button(s) to the global palette via a
  // CustomEvent — avoids the Header (Astro static) needing to import Vue.
  document.querySelectorAll('[data-vmx-search-open]').forEach((el) => {
    el.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('vmx:open-search'));
    });
  });
</script>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(10px) saturate(120%);
  background: color-mix(in oklab, var(--color-leader) 88%, transparent);
  border-bottom: 0;
}
.inner {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1.5rem;
  padding-block: 1.1rem 1rem;
}
.brand {
  display: inline-flex;
  align-items: baseline;
  gap: 0.85rem;
  text-decoration: none;
  color: inherit;
}
.brand:hover { color: inherit; }
.brand-ink {
  font-family: var(--font-display);
  font-weight: 800;
  font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 1;
  font-size: 1.45rem;
  letter-spacing: -0.025em;
  line-height: 1;
  font-style: italic;
}
.brand-ink .brand-mid {
  color: var(--color-stamp);
  font-style: normal;
  display: inline-block;
  transform: translateY(-0.05em);
  margin-inline: 0.04em;
}
.brand-meta {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  font-family: var(--font-mono);
  font-size: 0.66rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--fg-mute);
}
.brand .dot {
  width: 6px; height: 6px; border-radius: 999px;
  background: var(--color-stamp);
  box-shadow: 0 0 12px color-mix(in srgb, var(--color-stamp) 60%, transparent);
}

.nav {
  list-style: none;
  margin: 0; padding: 0;
  display: flex;
  gap: clamp(0.6rem, 1.2vw, 1.4rem);
}
.nav-link {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--fg-mute);
  text-decoration: none;
  padding-block: 0.25rem;
  border-bottom: 1px solid transparent;
  transition: color 200ms ease, border-color 200ms ease;
}
.nav-link:hover { color: var(--color-paper); }
.nav-link.is-active {
  color: var(--color-paper);
  border-bottom-color: var(--color-stamp);
}

.search-trigger {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: transparent;
  border: 1px solid var(--color-line-dark);
  color: var(--fg-mute);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 0.32rem 0.55rem 0.32rem 0.65rem;
  cursor: pointer;
  transition: border-color .2s ease, color .2s ease, background .2s ease;
}
.search-trigger:hover {
  color: var(--color-paper);
  border-color: var(--color-paper);
  background: var(--color-leader-2);
}
.search-trigger svg { color: var(--color-stamp); flex-shrink: 0; }
.search-trigger .kbd-hint {
  background: var(--color-leader-2);
  color: var(--fg-mute);
  border: 1px solid var(--color-line-dark);
  border-radius: 3px;
  padding: 0.05rem 0.32rem;
  font-size: 0.62rem;
  letter-spacing: 0.04em;
  font-weight: 600;
}
.search-trigger:hover .kbd-hint { color: var(--color-paper); border-color: var(--color-paper); }

@media (max-width: 760px) {
  .inner { flex-direction: column; align-items: flex-start; gap: 0.6rem; padding-block: 0.9rem; }
  .nav { flex-wrap: wrap; }
  .brand-meta .meta-text { display: none; }
  .search-trigger .search-label, .search-trigger .kbd-hint { display: none; }
}
</style>
