---
import Page from '../../layouts/Page.astro';
import Die from '../../components/Die.astro';
import Stamp from '../../components/Stamp.astro';
import Card from '../../components/Card.astro';
import { reviewIndex } from '../../lib/data';
import { reviewSlug, slugify } from '../../lib/slug';
import { formatNorwegianDate, formatRuntime, ratingLabel, sanitizeQuotes } from '../../lib/format';
import type { ReviewIndexEntry } from '../../lib/types';
import { enrichmentFor, tmdbUrl, imdbUrl } from '../../lib/enrichment';
import { readFileSync } from 'node:fs';
import { resolve as resolvePath } from 'node:path';

// Read external-ratings.json at build time. This is the public file
// sync-data writes (so the rest of the site loads it client-side too).
// We read via fs.readFileSync for the same Vite-cold-start reasons as
// data.ts / enrichment.ts.
const EXT_RATINGS_PATH = resolvePath(process.cwd(), 'public', 'data', 'external-ratings.json');
let _externalRatings: Record<string, { imdb?: number; imdbVotes?: number; rt?: number; mc?: number }> = {};
try { _externalRatings = JSON.parse(readFileSync(EXT_RATINGS_PATH, 'utf8')); } catch {}
function externalFor(reviewId: string) {
  return _externalRatings[reviewId] ?? null;
}
import { eligibleSlugs } from '../../lib/people';
import { u } from '../../lib/url';

// Whether a name has a person page worth linking to. Splits joint credits
// like "Phil Lord og Christopher Miller" so each gets its own anchor.
function personLinks(name: string | null | undefined) {
  if (!name) return [];
  return name
    .split(/\s+og\s+|,\s*/i)
    .map((s) => s.trim())
    .filter(Boolean)
    .map((n) => {
      const slug = slugify(n);
      return { name: n, slug, exists: eligibleSlugs.has(slug) };
    });
}

export async function getStaticPaths() {
  return reviewIndex.map((r) => ({
    params: { slug: r.slug },
    props: { review: r },
  }));
}

interface Props { review: ReviewIndexEntry; }
const { review: r } = Astro.props;

const idx = reviewIndex.indexOf(r);
const prev = idx > 0 ? reviewIndex[idx - 1] : null;
const next = idx < reviewIndex.length - 1 ? reviewIndex[idx + 1] : null;

// Find related: same director or shared genre, same type, prefer close years
const refDirector = r.factbox?.regi ?? r.factbox?.serieskaper ?? null;
const refGenres = new Set((r.factbox?.sjanger ?? []).map((g) => g.toLowerCase()));

const related = reviewIndex
  .filter((x) => x.id !== r.id && x.type === r.type)
  .map((x) => {
    let score = 0;
    const xd = x.factbox?.regi ?? x.factbox?.serieskaper ?? null;
    if (refDirector && xd === refDirector) score += 100;
    for (const g of x.factbox?.sjanger ?? []) if (refGenres.has(g.toLowerCase())) score += 5;
    score -= Math.abs((x.year || 0) - (r.year || 0)) * 0.1;
    return { x, score };
  })
  .filter((p) => p.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 6)
  .map((p) => p.x);

const dirRelated = refDirector
  ? reviewIndex.filter((x) => x.id !== r.id && (x.factbox?.regi === refDirector || x.factbox?.serieskaper === refDirector)).slice(0, 6)
  : [];

const isMasterpiece = r.rating === 6;
const isWorst = r.rating === 1;

const tmdb = enrichmentFor(r.id);
// Prefer NRK editor's chosen og:image (better cropping, includes overlay text)
// but fall back to TMDB poster when NRK image is missing.
const heroImage = r.image ?? tmdb?.poster ?? null;
const backdrop = tmdb?.backdrop ?? null;

const ext = externalFor(r.id);
const hasAnyExternal = !!(tmdb?.voteAverage != null || ext?.imdb != null || ext?.rt != null || ext?.mc != null);

// Norwegian streaming/rent/buy options, sourced from TMDB via JustWatch.
// TMDB doesn't index games, so the two game reviews here that found a
// match did so against same-titled LEGO movies — surface no providers
// for those, the data isn't about the work the reader is reading about.
function dedupeById<T extends { id: number }>(items: T[]): T[] {
  const seen = new Set<number>();
  return items.filter((p) => (seen.has(p.id) ? false : (seen.add(p.id), true)));
}
const watchNO = r.type === 'Game' ? null : (tmdb?.watchProvidersNO ?? null);
const watchStream = dedupeById([...(watchNO?.flatrate ?? []), ...(watchNO?.ads ?? [])]);
const streamIds = new Set(watchStream.map((p) => p.id));
const watchRentBuy = dedupeById([...(watchNO?.rent ?? []), ...(watchNO?.buy ?? [])])
  .filter((p) => !streamIds.has(p.id));
const hasWatchOptions = watchStream.length > 0 || watchRentBuy.length > 0;
const birgerPct = r.rating != null ? Math.round(((r.rating - 1) / 5) * 100) : null;
// Verdict colors for each source (gold = liked, red = disliked, neutral cream)
function verdict(score: number | null | undefined, kind: 'r6' | 'r10' | 'r100'): string {
  if (score == null) return 'mute';
  const pct = kind === 'r6' ? ((score - 1) / 5) * 100
            : kind === 'r10' ? score * 10
            : score;
  if (pct >= 70) return 'gold';
  if (pct <= 40) return 'red';
  return 'paper';
}
---

<Page
  current="reviews"
  title={`${sanitizeQuotes(r.name)} — terningkast ${r.rating ?? '—'} — Birgerpedia`}
  description={r.headline ? `«${r.headline}» — Birger Vestmos anmeldelse av ${sanitizeQuotes(r.name)}` : undefined}
  ogImage={r.image}
>
  <article class="review-page">

    <!-- ============================================
         HEAD
         ============================================ -->
    <header class="r-head">
      <nav class="crumbs h-eyebrow" aria-label="brødsmuler">
        <a href={u('/reviews')}>Indeksen</a>
        <span class="sep">/</span>
        <span>№ {String(reviewIndex.length - idx).padStart(4, '0')}</span>
      </nav>

      <div class="r-grid">
        <div class="r-meta">
          <div class="r-kicker h-kicker">
            {r.reviewType ?? 'Anmeldelse'}
            {r.platform && (<><span class="sep">·</span><span>{r.platform}</span></>)}
          </div>

          <h1 class="r-title h-display">{sanitizeQuotes(r.name)}</h1>

          {r.originalTitle && r.originalTitle !== r.name && (
            <div class="r-orig italic">«{r.originalTitle}»</div>
          )}

          {r.headline && (
            <p class="r-headline italic">«{sanitizeQuotes(r.headline)}»</p>
          )}

          <ul class="r-credits t-mono">
            {r.factbox?.regi && (
              <li>
                <span class="lab">Regi</span>
                <span class="val">
                  {personLinks(r.factbox.regi).map((p, i) => (
                    <>
                      {i > 0 && <span class="comma">, </span>}
                      {p.exists
                        ? <a href={u(`/people/${p.slug}`)}>{p.name}</a>
                        : <span>{p.name}</span>}
                    </>
                  ))}
                </span>
              </li>
            )}
            {r.factbox?.serieskaper && (
              <li>
                <span class="lab">Serieskaper</span>
                <span class="val">
                  {personLinks(r.factbox.serieskaper).map((p, i) => (
                    <>
                      {i > 0 && <span class="comma">, </span>}
                      {p.exists
                        ? <a href={u(`/people/${p.slug}`)}>{p.name}</a>
                        : <span>{p.name}</span>}
                    </>
                  ))}
                </span>
              </li>
            )}
            {r.factbox?.skuespillere && r.factbox.skuespillere.length > 0 && (
              <li>
                <span class="lab">Med</span>
                <span class="val">
                  {r.factbox.skuespillere.map((name, i) => {
                    const slug = slugify(name);
                    const exists = eligibleSlugs.has(slug);
                    return (
                      <>
                        {i > 0 && <span class="comma">, </span>}
                        {exists ? <a href={u(`/people/${slug}`)}>{name}</a> : <span>{name}</span>}
                      </>
                    );
                  })}
                </span>
              </li>
            )}
            {r.factbox?.sjanger && r.factbox.sjanger.length > 0 && (
              <li><span class="lab">Sjanger</span>
                <span class="val">{r.factbox.sjanger.join(', ')}</span></li>
            )}
            {r.factbox?.lengdeMinutes && (
              <li><span class="lab">Lengde</span><span class="val">{formatRuntime(r.factbox.lengdeMinutes)}</span></li>
            )}
            {r.factbox?.aldersgrense && (
              <li><span class="lab">Aldersgrense</span><span class="val">{r.factbox.aldersgrense}</span></li>
            )}
            {r.factbox?.distributor && (
              <li><span class="lab">Distributør</span><span class="val">{r.factbox.distributor}</span></li>
            )}
            {r.factbox?.norgespremiere && (
              <li><span class="lab">Norgespremiere</span><span class="val">{formatNorwegianDate(r.factbox.norgespremiere)}</span></li>
            )}
            {r.factbox?.land && r.factbox.land.length > 0 && (
              <li><span class="lab">Land</span><span class="val">{r.factbox.land.join(', ')}</span></li>
            )}
          </ul>
        </div>

        <div class="r-rating">
          <div class="rating-block">
            <div class="rating-die anim-roll-in">
              <Die value={r.rating} size={140} variant="paper" rotate={-6} />
            </div>
            <div class="rating-text">
              <div class="rating-num t-mono">{r.rating ?? '—'} av {r.ratingMax}</div>
              <div class="rating-word italic">{ratingLabel(r.rating)}</div>
            </div>
            {isMasterpiece && (
              <div class="badge"><Stamp text="MESTERVERK" rotate={-9} /></div>
            )}
            {isWorst && (
              <div class="badge"><Stamp text="UNDERMÅLER" rotate={5} color="var(--color-mute)" /></div>
            )}
          </div>

          <div class="meta-line t-meta">
            <span>Publisert {formatNorwegianDate(r.publishedAt)}</span>
            {r.modifiedAt && r.modifiedAt !== r.publishedAt && (
              <span> · oppdatert {formatNorwegianDate(r.modifiedAt)}</span>
            )}
          </div>
        </div>

        {r.image && (
          <div class="r-image">
            <img src={r.image} alt={sanitizeQuotes(r.name)} loading="eager" />
          </div>
        )}
      </div>
    </header>

    {hasAnyExternal && (
      <!-- ============================================
           HVA SIER VERDEN — cross-source rating comparison
           ============================================ -->
      <section class="verdicts" aria-label="Andre meninger om dette verket">
        <header class="verdicts-head">
          <div class="h-eyebrow">Hva sier verden?</div>
          <h2 class="vs-title h-headline">
            Birger vs. <em>resten</em>
          </h2>
        </header>

        <ol class="vs-grid">
          <li class={`vs-card vs-birger ${verdict(r.rating, 'r6')}`}>
            <span class="vs-src">Birger</span>
            <span class="vs-score">
              <span class="vs-n">{r.rating ?? '—'}</span>
              <span class="vs-scale">/ 6</span>
            </span>
            <span class="vs-bar"><span style={`width: ${birgerPct ?? 0}%`}></span></span>
            <span class="vs-note">Filmpolitiet</span>
          </li>

          {tmdb?.voteAverage != null && tmdb.voteCount && tmdb.voteCount > 0 && (
            <li class={`vs-card ${verdict(tmdb.voteAverage, 'r10')}`}>
              <span class="vs-src">TMDB</span>
              <span class="vs-score">
                <span class="vs-n">{tmdb.voteAverage.toFixed(1).replace('.', ',')}</span>
                <span class="vs-scale">/ 10</span>
              </span>
              <span class="vs-bar"><span style={`width: ${tmdb.voteAverage * 10}%`}></span></span>
              <span class="vs-note">{tmdb.voteCount.toLocaleString('nb-NO')} stemmer</span>
            </li>
          )}

          {ext?.imdb != null && (
            <li class={`vs-card ${verdict(ext.imdb, 'r10')}`}>
              <span class="vs-src">IMDb</span>
              <span class="vs-score">
                <span class="vs-n">{ext.imdb.toFixed(1).replace('.', ',')}</span>
                <span class="vs-scale">/ 10</span>
              </span>
              <span class="vs-bar"><span style={`width: ${ext.imdb * 10}%`}></span></span>
              <span class="vs-note">
                {ext.imdbVotes != null
                  ? `${ext.imdbVotes.toLocaleString('nb-NO')} stemmer`
                  : 'IMDb-snitt'}
              </span>
            </li>
          )}

          {ext?.rt != null && (
            <li class={`vs-card ${verdict(ext.rt, 'r100')}`}>
              <span class="vs-src">Rotten Tomatoes</span>
              <span class="vs-score">
                <span class="vs-n">{ext.rt}</span>
                <span class="vs-scale">%</span>
              </span>
              <span class="vs-bar"><span style={`width: ${ext.rt}%`}></span></span>
              <span class="vs-note">tomatometer</span>
            </li>
          )}

          {ext?.mc != null && (
            <li class={`vs-card ${verdict(ext.mc, 'r100')}`}>
              <span class="vs-src">Metacritic</span>
              <span class="vs-score">
                <span class="vs-n">{ext.mc}</span>
                <span class="vs-scale">/ 100</span>
              </span>
              <span class="vs-bar"><span style={`width: ${ext.mc}%`}></span></span>
              <span class="vs-note">metascore</span>
            </li>
          )}
        </ol>
      </section>
    )}

    <!-- ============================================
         CTA: read at NRK
         ============================================ -->
    <section class="cta-card">
      <div class="cta-text">
        <div class="h-kicker">Hele anmeldelsen</div>
        <p>
          Birger Vestmo skriver for NRK Filmpolitiet. Anmeldelsens fulle tekst,
          bilder, og eventuelle traileres ligger der den hører hjemme — hos NRK.
        </p>
      </div>
      <a class="btn btn-stamp" href={r.url} target="_blank" rel="noopener">
        Les hos NRK ↗
      </a>
    </section>

    {hasWatchOptions && (
      <!-- ============================================
           Hvor kan du se den? — TMDB watch providers (NO locale)
           ============================================ -->
      <section class="watch" aria-labelledby="watch-title">
        <header class="watch-head">
          <div class="h-eyebrow">Tilgjengelig i Norge</div>
          <h2 id="watch-title" class="section-title h-headline">
            Hvor kan du <em>se den</em>?
          </h2>
        </header>

        {watchStream.length > 0 && (
          <div class="watch-row">
            <div class="watch-label t-mono">Strøm</div>
            <ul class="watch-list">
              {watchStream.map((p) => (
                <li>
                  <a class="watch-chip" href={watchNO?.link ?? '#'} target="_blank" rel="noopener" title={`Se ${p.name}`}>
                    {p.logo && <img src={p.logo} alt={p.name} loading="lazy" width="28" height="28" />}
                    <span class="watch-name">{p.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {watchRentBuy.length > 0 && (
          <div class="watch-row">
            <div class="watch-label t-mono">Lei eller kjøp</div>
            <ul class="watch-list">
              {watchRentBuy.map((p) => (
                <li>
                  <a class="watch-chip" href={watchNO?.link ?? '#'} target="_blank" rel="noopener" title={`Lei eller kjøp på ${p.name}`}>
                    {p.logo && <img src={p.logo} alt={p.name} loading="lazy" width="28" height="28" />}
                    <span class="watch-name">{p.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <p class="watch-credit t-meta">
          Data fra <a href={watchNO?.link ?? 'https://www.justwatch.com'} target="_blank" rel="noopener">JustWatch via TMDB ↗</a>
        </p>
      </section>
    )}

    {tmdb && (
      <!-- ============================================
           ENRICHED METADATA
           ============================================ -->
      <section class="tmdb">
        <header class="tmdb-head">
          <div class="tmdb-head-text">
            <div class="h-eyebrow">Fra TMDB</div>
            <h2 class="section-title h-headline">
              <em>Verket</em> bak anmeldelsen
            </h2>
            {tmdb.tagline && <p class="tagline italic">«{tmdb.tagline}»</p>}
          </div>

          <!-- External links pinned to the top-right of the title block
               instead of orphaned at the bottom of the section. -->
          <div class="tmdb-links" aria-label="Eksterne lenker">
            {tmdbUrl(tmdb) && <a class="btn" href={tmdbUrl(tmdb)} target="_blank" rel="noopener">TMDB ↗</a>}
            {imdbUrl(tmdb) && <a class="btn" href={imdbUrl(tmdb)} target="_blank" rel="noopener">IMDb ↗</a>}
            {tmdb.external.wikidata && (
              <a class="btn" href={`https://www.wikidata.org/wiki/${tmdb.external.wikidata}`} target="_blank" rel="noopener">Wikidata ↗</a>
            )}
          </div>
        </header>

        <!-- Facts strip — always full-width, tile grid that auto-wraps. -->
        <ul class="tmdb-facts">
          {tmdb.runtime && tmdb.runtime > 0 && (
            <li>
              <span class="lab">Spilletid</span>
              <span class="val t-mono">{formatRuntime(tmdb.runtime)}</span>
            </li>
          )}
          {tmdb.releaseDate && (
            <li>
              <span class="lab">Verdenspremiere</span>
              <span class="val">{formatNorwegianDate(tmdb.releaseDate)}</span>
            </li>
          )}
          {tmdb.voteAverage != null && tmdb.voteCount != null && tmdb.voteCount > 0 && (
            <li>
              <span class="lab">TMDB-snitt</span>
              <span class="val">
                <span class="t-mono">{tmdb.voteAverage.toFixed(1).replace('.', ',')}</span>
                <span class="muted"> / 10 · {tmdb.voteCount.toLocaleString('nb-NO')} stemmer</span>
              </span>
            </li>
          )}
          {tmdb.budget && tmdb.budget > 0 && (
            <li>
              <span class="lab">Budsjett</span>
              <span class="val t-mono">${(tmdb.budget / 1_000_000).toFixed(1).replace('.', ',')} M</span>
            </li>
          )}
          {tmdb.revenue && tmdb.revenue > 0 && (
            <li>
              <span class="lab">Inntjening</span>
              <span class="val t-mono">${(tmdb.revenue / 1_000_000).toFixed(1).replace('.', ',')} M</span>
            </li>
          )}
          {tmdb.productionCountries.length > 0 && (
            <li>
              <span class="lab">Land</span>
              <span class="val">{tmdb.productionCountries.join(', ')}</span>
            </li>
          )}
          {tmdb.productionCompanies.length > 0 && (
            <li class="wide">
              <span class="lab">Selskap</span>
              <span class="val">{tmdb.productionCompanies.slice(0, 3).join(', ')}</span>
            </li>
          )}
          {tmdb.crew.dop && (
            <li>
              <span class="lab">Foto</span>
              <span class="val">
                {personLinks(tmdb.crew.dop).map((p, i) => (
                  <>
                    {i > 0 && <span class="comma">, </span>}
                    {p.exists
                      ? <a href={u(`/people/${p.slug}`)}>{p.name}</a>
                      : <span>{p.name}</span>}
                  </>
                ))}
              </span>
            </li>
          )}
          {tmdb.crew.composer && (
            <li>
              <span class="lab">Musikk</span>
              <span class="val">
                {personLinks(tmdb.crew.composer).map((p, i) => (
                  <>
                    {i > 0 && <span class="comma">, </span>}
                    {p.exists
                      ? <a href={u(`/people/${p.slug}`)}>{p.name}</a>
                      : <span>{p.name}</span>}
                  </>
                ))}
              </span>
            </li>
          )}
          {tmdb.crew.editor && (
            <li>
              <span class="lab">Klipp</span>
              <span class="val">
                {personLinks(tmdb.crew.editor).map((p, i) => (
                  <>
                    {i > 0 && <span class="comma">, </span>}
                    {p.exists
                      ? <a href={u(`/people/${p.slug}`)}>{p.name}</a>
                      : <span>{p.name}</span>}
                  </>
                ))}
              </span>
            </li>
          )}
        </ul>

        {tmdb.overview && (
          <div class="tmdb-overview">
            <div class="h-eyebrow">Synopsis</div>
            <p>{tmdb.overview}</p>
          </div>
        )}

        {tmdb.cast.length > 0 && (
          <div class="tmdb-cast">
            <div class="h-eyebrow">På lerretet</div>
            <ul class="cast-grid">
              {tmdb.cast.map((c) => {
                const slug = slugify(c.name);
                const exists = eligibleSlugs.has(slug);
                const Tag = exists ? 'a' : 'div';
                return (
                  <li class="cast-item">
                    <Tag href={exists ? u(`/people/${slug}`) : undefined} class="cast-link">
                      <div class="cast-avatar">
                        {c.profile
                          ? <img src={c.profile} alt={c.name} loading="lazy" />
                          : <span class="cast-monogram">{c.name.split(' ').map((p) => p[0]).slice(0, 2).join('')}</span>
                        }
                      </div>
                      <span class="cast-name">{c.name}</span>
                      {c.character && <span class="cast-char italic">{c.character}</span>}
                    </Tag>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        {tmdb.keywords.length > 0 && (
          <div class="tmdb-keywords">
            <div class="h-eyebrow">Stikkord</div>
            <div class="kw-row">
              {tmdb.keywords.map((k) => (
                <span class="kw">{k}</span>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <!-- ============================================
         RELATED
         ============================================ -->
    {(related.length || dirRelated.length) > 0 && (
      <section class="related">
        {dirRelated.length > 0 && (
          <div class="related-section">
            <div class="h-eyebrow">Mer fra {refDirector}</div>
            <div class="related-grid">
              {dirRelated.map((x) => <Card r={x} variant="compact" />)}
            </div>
          </div>
        )}

        {related.length > 0 && (
          <div class="related-section">
            <div class="h-eyebrow">Du kan også like</div>
            <div class="related-grid">
              {related.map((x) => <Card r={x} variant="compact" />)}
            </div>
          </div>
        )}
      </section>
    )}

    <!-- ============================================
         PREV / NEXT
         ============================================ -->
    <nav class="prev-next" aria-label="bla i korpuset">
      {next && (
        <a href={u(`/reviews/${next.slug}`)} class="pn pn-prev" data-nav="prev">
          <span class="pn-arrow">←</span>
          <span class="pn-content">
            <span class="h-eyebrow">Eldre · <kbd>p</kbd></span>
            <span class="pn-title">{sanitizeQuotes(next.name)}</span>
          </span>
        </a>
      )}
      {prev && (
        <a href={u(`/reviews/${prev.slug}`)} class="pn pn-next" data-nav="next">
          <span class="pn-content right">
            <span class="h-eyebrow"><kbd>n</kbd> · Nyere</span>
            <span class="pn-title">{sanitizeQuotes(prev.name)}</span>
          </span>
          <span class="pn-arrow">→</span>
        </a>
      )}
    </nav>
  </article>

  <script>
    // Per-page keyboard nav: n = next (newer), p = previous (older), r = random.
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (t?.matches?.('input, textarea, select')) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      if (e.key === 'n') {
        const a = document.querySelector('a[data-nav="next"]') as HTMLAnchorElement | null;
        if (a) { e.preventDefault(); location.href = a.href; }
      } else if (e.key === 'p') {
        const a = document.querySelector('a[data-nav="prev"]') as HTMLAnchorElement | null;
        if (a) { e.preventDefault(); location.href = a.href; }
      } else if (e.key === 'r') {
        e.preventDefault();
        // BASE_URL is injected by Vite/Astro at build time.
        location.href = import.meta.env.BASE_URL + 'random';
      }
    });
